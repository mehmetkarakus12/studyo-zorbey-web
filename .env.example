# Supabase — Project Settings > API sayfasından alın.
# Bu değerler tarayıcıya açık (public) olduğu için NEXT_PUBLIC_ önekini taşır;
# bu normaldir, RLS politikaları bu anahtarla yapılan istekleri korur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key SADECE ileride sunucu-taraflı (server-only) admin
# işlemleri için kullanılacak (ör. Route Handler / Server Function içinde).
# ASLA NEXT_PUBLIC_ öneki almamalı ve tarayıcıya açılmamalıdır.
# Bu değer bu fazda (Faz 2.1) kullanılmıyor; ileride ihtiyaç duyulursa eklenir.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Yeni talep bildirimleri (e-posta) -------------------------------------
# Server-only değerlerdir, ASLA NEXT_PUBLIC_ öneki almaz. Eksikse bildirim
# kanalı sessizce devre dışı kalır (Supabase kaydı etkilenmez).

# Resend — resend.com/api-keys sayfasından alın.
# RESEND_API_KEY=

# Bildirimlerin gönderileceği işletme e-posta adresi.
# NOTIFICATION_EMAIL=

# Resend'de doğrulanmış gönderen adresi (ör. bildirim@stüdyozorbey.com
# veya Resend'in sağladığı onboarding@resend.dev test adresi).
# NOTIFICATION_FROM_EMAIL=
